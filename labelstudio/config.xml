<View>
  <Style>
    .meta { background: #f5f7fa; border-radius: 8px; padding: 10px 14px; }
    .claim-card { background: #fff8e6; border-left: 4px solid #d99a00; border-radius: 8px; padding: 12px 16px; }
    .evidence-card { background: #f2f8ff; border-left: 4px solid #3578c6; border-radius: 8px; padding: 12px 16px; }
    .decision-card { background: #fafafa; border: 1px solid #d9dfe8; border-radius: 8px; padding: 12px 16px; }
    .small-note { color: #596579; font-size: 0.9em; }
  </Style>

  <Header value="Revisión rápida de evidencia médica" />
  <Markdown value="Lee primero el claim y la evidencia principal. Expande los otros candidatos solo si necesitas confirmar la decisión. La similitud ordena los artículos, pero no decide la etiqueta." />

  <View className="meta" style="display: flex; gap: 16px;">
    <View style="flex: 1;">
      <Text name="record" value="Registro: $record_id" />
      <Text name="country" value="País: $country" />
    </View>
    <View style="flex: 2;">
      <Text name="source" value="Fuente: $source_name" />
      <Text name="title" value="Título: $title" />
    </View>
  </View>

  <View className="claim-card">
    <Header value="Claim que debes verificar" />
    <Text name="claim" value="$claim_text" />
  </View>

  <View className="evidence-card">
    <Header value="Evidencia principal" />
    <Text name="evidence_primary" value="$evidence_primary" />
  </View>

  <Collapse accordion="true" open="false">
    <Panel value="Ver otros candidatos PubMed">
      <View>
        <Text name="evidence_additional" value="$evidence_additional" />
      </View>
    </Panel>
  </Collapse>

  <Collapse accordion="true" open="false">
    <Panel value="Detalles técnicos de la búsqueda">
      <View className="small-note">
        <Text name="query" value="Consulta PubMed (inglés): $pubmed_query_en" />
        <Text name="claim-en" value="Claim en inglés: $claim_text_en" />
        <Text name="status" value="Estado: $evidence_status | Candidatos: $evidence_count" />
        <Text name="scores" value="Mejor PMID: $best_pmid | Embed 4: $best_embedding_similarity | TF-IDF: $best_tfidf_similarity" />
        <Text name="run" value="Evidence run: $evidence_run_id" />
      </View>
    </Panel>
  </Collapse>

  <View className="decision-card" style="display: flex; gap: 24px;">
    <View style="flex: 1;">
      <Header value="¿Qué relación tiene la evidencia con el claim?" />
      <Markdown value="Apoya = respalda el contenido. Contradice = muestra lo contrario. No concluyente = no permite decidir." />
      <Choices name="evidence_relation" toName="claim" choice="single-radio" showInline="true" required="true" requiredMessage="Selecciona una relación.">
        <Choice value="supports" html="Apoya" hint="La evidencia respalda el claim." />
        <Choice value="contradicts" html="Contradice" hint="La evidencia muestra lo contrario." />
        <Choice value="unclear" html="No concluyente" hint="No permite confirmar ni refutar." />
      </Choices>
    </View>
    <View style="flex: 1;">
      <Header value="Etiqueta final de la noticia" />
      <Choices name="final_label" toName="claim" choice="single-radio" showInline="true" required="true" requiredMessage="Selecciona una etiqueta final.">
        <Choice value="RESPALDADA" hint="La evidencia respalda el claim." />
        <Choice value="REFUTADA" hint="La evidencia contradice el claim." />
        <Choice value="NO_DETERMINABLE" hint="La evidencia no alcanza para decidir." />
        <Choice value="EXCLUIDA" hint="No es apta para el corpus." />
      </Choices>
    </View>
  </View>

  <Header value="Justificación humana (obligatoria)" />
  <TextArea name="verification_note" toName="claim" required="true" maxSubmissions="1" placeholder="Indica el PMID usado y explica brevemente por qué elegiste la relación y la etiqueta." />
</View>
