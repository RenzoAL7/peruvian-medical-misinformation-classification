# Sistema y entorno
.DS_Store
.env
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
checkpoints/

# Datos locales y artefactos generados
# Los resultados de cada corrida y las revisiones humanas se conservan localmente.
# No se suben al repositorio ni se mezclan con credenciales.
data/raw/*
!data/raw/.gitkeep
!data/raw/source_url_runs/
data/raw/source_url_runs/*
!data/raw/source_url_runs/.gitkeep
data/review/*
!data/review/.gitkeep
data/processed/*
!data/processed/.gitkeep
reports/*
!reports/.gitkeep

# Credenciales y archivos pesados comunes
*.key
*.pem
*.pt
*.pth
*.ckpt
